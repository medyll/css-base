{
  "name": "@medyll/css-base",
  "version": "0.7.4",
  "description": "Pure CSS design system library",
  "layers": ["reset", "tokens", "theme", "components", "utilities"],
  "files": [
    {
      "file": "app.css",
      "description": "Entry point — declares layer order and imports the full system"
    },
    {
      "file": "base.css",
      "description": "HTML element defaults and base document styling",
      "layer": "reset"
    },
    {
      "file": "reset.css",
      "description": "Browser reset and low-level element normalization",
      "layer": "reset"
    },
    {
      "file": "theme.css",
      "description": "Theme seed tokens: default font, text, and surface values",
      "layer": "theme"
    },
    {
      "file": "variables.css",
      "description": "Raw spacing and size scale",
      "layer": "tokens"
    },
    {
      "file": "tokens.css",
      "description": "Semantic spacing, radius, motion, blur, and z-index tokens",
      "layer": "tokens"
    },
    {
      "file": "typography.css",
      "description": "Font families, text scale, line heights, weights, and tracking",
      "layer": "tokens"
    },
    {
      "file": "functions.css",
      "description": "CSS @function helpers for color manipulation and harmony generation",
      "layer": null,
      "minChromium": 139
    },
    {
      "file": "palette.css",
      "description": "Semantic colors, surfaces, borders, shadows, and color scheme",
      "layer": "theme"
    },
    {
      "file": "components.css",
      "description": "Styled elements and components such as buttons, cards, forms, lists, panels, and tables",
      "layer": "components"
    },
    {
      "file": "utilities.css",
      "description": "Layout, spacing, typography, color, state, and responsive utility classes",
      "layer": "utilities"
    },
    {
      "file": "attr.css",
      "description": "Attribute-driven utilities via attr() for spacing, typography, transforms, and effects",
      "layer": "utilities",
      "minChromium": 139
    }
  ],
  "compatibility": {
    "baselineBrowsers": ["Chrome >= 125", "Edge >= 125"],
    "enhancedBrowsers": ["Chromium >= 139 for @function and attr()"],
    "features": [
      "@layer",
      "CSS nesting",
      "color-mix()",
      "light-dark()",
      "relative color syntax",
      "subgrid",
      "text-box-trim / text-box-edge",
      "@function (Chromium 139+)",
      "attr() typed utilities (Chromium 139+)"
    ]
  }
}
